# Local-only values for scripts/configure-supabase-auth.mjs
# Copy this file to .env.auth-setup and fill values locally.
# .env.auth-setup is ignored by Git and must never be committed.
SUPABASE_ACCESS_TOKEN=
SMTP_ADMIN_EMAIL=no-reply@auth.your-verified-domain.com
SMTP_PASS=re_replace_with_resend_api_key
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
