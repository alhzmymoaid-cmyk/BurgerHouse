# ============================================================================
# BURGER HOUSE — Environment Variables Template (NEVER COMMIT REAL SECRETS)
# ============================================================================

# Public Supabase Configuration (Safe for Browser / RLS Enforced)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here

# Server-Only Secrets (STRICTLY SERVER-SIDE — NEVER PREFIX WITH NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-here
ORDER_HMAC_SECRET=generate-a-64-char-random-hex-secret-for-tracking-tokens
CAPTCHA_SIGNING_SECRET=generate-a-64-char-random-hex-secret-for-captcha-tokens
SUPER_ADMIN_BOOTSTRAP_TOKEN=initial-one-time-bootstrap-secret

# Default Timezone & Currency
NEXT_PUBLIC_APP_TIMEZONE=Asia/Riyadh
NEXT_PUBLIC_DEFAULT_LOCALE=ar
